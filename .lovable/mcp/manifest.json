{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ydgexnboxazquiiqcrup.supabase.co/auth/v1",
    "resource": "https://mahavtaardailycollection.lovable.app/mcp",
    "accepted_audiences": ["authenticated"]
  },
  "mcp": {
    "server": {
      "name": "daily-collection-hub",
      "version": "0.5.0",
      "title": "Mahavtaar Daily Collection Hub"
    },
    "tools": [
      {
        "name": "loadCollectionData",
        "title": "Load Collection Data",
        "description": "Fetches and parses all rows from the primary Collections sheet, ensuring the data is structured correctly for display in the application (including normalized dates, times, amounts, receipts, remarks, Aman's remarks, allocation categories, Already Paid flags, and conflict status).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional allocation category filter (e.g. '1&2', 'Standard').",
              "type": "string"
            },
            "executive": {
              "description": "Optional executive filter.",
              "type": "string"
            },
            "loanId": {
              "description": "Optional loan ID filter.",
              "type": "string"
            },
            "dateFrom": {
              "description": "Optional start payment date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "dateTo": {
              "description": "Optional end payment date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "limit": {
              "default": 0,
              "description": "Max number of rows to return (0 = all rows).",
              "type": "integer",
              "minimum": 0,
              "maximum": 20000
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "read_all_collections",
        "title": "Read every row in complete Collections sheet",
        "description": "Reads every row in the complete Collections sheet without limits or omissions. Includes executive, loanId, amount, payment date, time, entryDate, entryType, settlement, receipts, remark, actualId, Aman's Remarks (Column S), case category, allocation date, and Already Paid flags.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 5000,
              "description": "Max rows to return (0 for no limit).",
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "offset": {
              "default": 0,
              "description": "Number of rows to skip.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "executive": {
              "description": "Optional filter by executive name.",
              "type": "string"
            },
            "loanId": {
              "description": "Optional filter by Loan ID.",
              "type": "string"
            },
            "dateFrom": {
              "description": "Optional start payment date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "dateTo": {
              "description": "Optional end payment date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "search": {
              "description": "Optional search term across loanId, remark, amansRemarks, or executive.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "loan_summary",
        "title": "Loan Summary & Sequential EMI Tracking",
        "description": "Calculates loan-level metrics across collection history: total paid, sequential EMI counts, short EMI amounts, foreclosure/settlement status, POS paid, and Main Paid status. Excludes Already Paid records by default.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "loanId": {
              "description": "Optional Loan ID to inspect.",
              "type": "string"
            },
            "executive": {
              "description": "Optional executive filter.",
              "type": "string"
            },
            "city": {
              "description": "Optional city filter.",
              "type": "string"
            },
            "bucket": {
              "description": "Optional bucket filter (e.g. 'Bucket 1', 'Bucket 2').",
              "type": "string"
            },
            "month": {
              "description": "Optional month filter (YYYY-MM).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "category": {
              "description": "Optional Allocation Category filter.",
              "type": "string"
            },
            "status": {
              "description": "Optional status filter (e.g. 'EMI Paid', 'Settlement Paid', 'Foreclosure Paid', 'EMI Short Amount', 'POS Paid — Not Main Paid').",
              "type": "string"
            },
            "mainPaidOnly": {
              "default": false,
              "description": "If true, only returns Main Paid cases.",
              "type": "boolean"
            },
            "limit": {
              "default": 100,
              "description": "Max records to return.",
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "short_emi_cases",
        "title": "List Short EMI Cases",
        "description": "Lists collection cases that have an active EMI shortfall (where the borrower paid partially towards an EMI). Shows which EMI is short, remaining short amount, executive, and POS status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "month": {
              "description": "Optional month filter (YYYY-MM).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "category": {
              "description": "Optional Allocation Category filter.",
              "type": "string"
            },
            "executive": {
              "description": "Optional executive filter.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "loan_payments",
        "title": "Payments for a Loan ID",
        "description": "List all recorded payments for one Loan ID, including Already Paid flags.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "loanId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "Loan ID to look up."
            }
          },
          "required": ["loanId"],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "executive_city_report",
        "title": "Executive City Report & Performance Breakdown",
        "description": "Generates executive-wise city breakdown tables showing collection amount, case count, Main Paid cases, paid EMI count, POS* cases, and paid POS amount per executive and city, along with summary totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "date": {
              "description": "Optional single date filter (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "month": {
              "description": "Optional month filter (YYYY-MM).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "category": {
              "description": "Optional Allocation Category filter.",
              "type": "string"
            },
            "bucket": {
              "description": "Optional Bucket filter (e.g. 'Bucket 1').",
              "type": "string"
            },
            "executive": {
              "description": "Optional executive filter.",
              "type": "string"
            },
            "includeBucket": {
              "default": false,
              "description": "If true, breaks down rows by City + Bucket instead of City only.",
              "type": "boolean"
            },
            "excludeAlreadyPaid": {
              "default": true,
              "description": "If true, excludes Already Paid cases (default true).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "detailed_report",
        "title": "Comprehensive Daily and Monthly Collection Report",
        "description": "Produces full analytical collection report matching the application's Reports tab: date-wise collection totals, executive breakdown (including Normal vs Previous Paid case counts, Main Paid cases, Paid EMIs, POS*), bucket-wise totals, and city/bucket sections. Already Paid cases are excluded.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "month": {
              "description": "Optional month filter (YYYY-MM).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "dateFrom": {
              "description": "Optional start payment date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "dateTo": {
              "description": "Optional end payment date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "category": {
              "description": "Optional Allocation Category filter.",
              "type": "string"
            },
            "bucket": {
              "description": "Optional Bucket filter.",
              "type": "string"
            },
            "executive": {
              "description": "Optional executive filter.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "collection_summary",
        "title": "Collection summary by executive",
        "description": "Total collection amount and case count per executive for a payment date range (Already Paid cases excluded).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start payment date, YYYY-MM-DD."
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "End payment date, YYYY-MM-DD (inclusive)."
            },
            "category": {
              "description": "Optional Allocation Category filter.",
              "type": "string",
              "maxLength": 80
            }
          },
          "required": ["from", "to"],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_already_paid",
        "title": "List Already Paid Cases",
        "description": "Lists payment entries made prior to their Allocation Date (Already Paid cases). These are kept for reference and excluded from all official collection totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "month": {
              "description": "Optional month filter (YYYY-MM).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "category": {
              "description": "Optional Allocation Category filter.",
              "type": "string"
            },
            "executive": {
              "description": "Optional executive filter.",
              "type": "string"
            },
            "dateFrom": {
              "description": "Optional start payment date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "dateTo": {
              "description": "Optional end payment date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "open_receipt_image",
        "title": "Open receipt images directly in Google Drive",
        "description": "Resolves and provides direct Google Drive view, preview, and download links for collection receipt images. Can look up receipts by Loan ID, Google Sheet row number, or direct Drive URL/File ID.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "receiptUrl": {
              "description": "Google Drive file URL or File ID.",
              "type": "string"
            },
            "loanId": {
              "description": "Loan ID to find all attached receipts for.",
              "type": "string"
            },
            "rowNumber": {
              "description": "Collections sheet row number to find receipts for.",
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "scan_receipt_ocr",
        "title": "Scan receipt with server-side OCR",
        "description": "Reads an attached Google Drive receipt image using Google Drive OCR and compares extracted text with the selected Collections entry. It never changes the sheet.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "rowNumber": {
              "description": "Collections sheet row number.",
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991
            },
            "loanId": {
              "description": "Loan ID to find a receipt for.",
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "receiptUrl": {
              "description": "Direct Google Drive receipt URL or file ID.",
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "language": {
              "default": "hi",
              "description": "OCR language hint: Hindi, English, Marathi, or Gujarati.",
              "type": "string",
              "enum": ["hi", "en", "mr", "gu"]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "pending_receipts",
        "title": "Pending receipts",
        "description": "List payments still waiting in Pending Receipts queue, including pending ID, receipt photo links, amount, executive, and settlement flag.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "executive": {
              "description": "Optional executive filter.",
              "type": "string"
            },
            "loanNumber": {
              "description": "Optional loan number filter.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_ecs_entries",
        "title": "List ECS and Special entries",
        "description": "Lists ECS and Special collection entries from Google Sheets with optional status or executive filter.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "default": "All",
              "description": "Status filter: All, Confirmed, Bounced, Cancelled, or Cleared.",
              "type": "string",
              "enum": ["All", "Confirmed", "Bounced", "Cancelled", "Cleared"]
            },
            "executive": {
              "description": "Optional executive name filter.",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_conflicts",
        "title": "List payment conflicts and duplicates",
        "description": "Detects potential duplicate payment entries (same Loan ID and payment amount) with comparison details, receipt links, row numbers, and validation status ('VALIDATED' vs unvalidated).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "unresolvedOnly": {
              "default": true,
              "description": "If true, only returns groups where at least one entry is unvalidated.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_settings",
        "title": "Get app settings and feature flags",
        "description": "Returns the current feature toggle flags (entry, report, loans, execCities, pending, ecs, notifications, alreadyPaid, conflicts), default allocation category, and active announcement banners.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
