# Google Sheets & Drive credentials (optional if using local overlay/fallback)
# LOVABLE_API_KEY=

# Required for PIN login: HMAC-SHA256 stateless auth token signing secret (32+ random characters)
# Generate with: openssl rand -base64 48
AUTH_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Required for Admin / Productivity Desk server-side authorization
# MAHAVTAAR_ADMIN_PASSWORD=
